/* ============ 音频选项组件 ============
   audios: [{label:"频道 A",src:"audio/a.mp3"},...]
   没有 src 时自动用合成音兜底（方便预览）        */
function renderAudioQ(audios){
  const box=$("aopts");
  const players=[];let current=null,waveTimer=null;

  audios.forEach((a,i)=>{
    const el=document.createElement("button");
    el.className="aopt";
    el.innerHTML=
      '<span class="a-play">▶</span>'+
      '<span class="wave">'+Array.from({length:16},()=>" <i>").join("").replace(/ <i>/g,"<i></i> <i>").slice(0)+'</span>'
        /* 上面这行太绕，用下面的写法更清晰 —— 实际生成见 fix 行 */ ;
    /* --- 修正：频谱柱直接循环生成 --- */
    const w=el.querySelector(".wave");w.innerHTML="";
    for(let k=0;k<16;k++){const b=document.createElement("i");
      b.style.height=(10+Math.random()*15)+"%";w.appendChild(b);}
    el.insertAdjacentHTML("beforeend",
      '<span class="a-meta"><span class="a-state"></span>'+
      '<span class="a-no">CH-0'+(i+1)+'</span>'+
      '<span class="a-dur">0:0'+((i%3)+2)+'</span></span>');

    let audio=null;
    if(a.src){audio=new Audio(a.src);}
    else{ /* 合成音兜底：不同频道不同音色 */
      audio=synthTone([220,277,330,392][i%4]);
    }

    function stopAll(){
      players.forEach(p=>{p.audio.pause();p.audio.currentTime=0;
        p.el.classList.remove("playing");
        p.el.querySelector(".a-state").textContent="";
        clearInterval(p.timer);
        p.el.querySelectorAll(".wave i").forEach(b=>
          b.style.height=(10+Math.random()*15)+"%");});
      current=null;
    }
    function toggle(){
      if(el.classList.contains("locked"))return;
      if(current===el){stopAll();return;}     /* 再点一次=停止 */
      stopAll();
      current=el;
      el.classList.add("playing");
      el.querySelector(".a-play").textContent="■";
      el.querySelector(".a-state").textContent="◉ PLAYING";
      audio.play().catch(()=>{});
      waveTimer=setInterval(()=>{
        if(!el.isConnected)return clearInterval(waveTimer);
        el.querySelectorAll(".wave i").forEach(b=>{
          if(Math.random()<.85)b.style.height=(12+Math.random()*82)+"%";});
      },110);
      audio.onended=()=>{if(current===el)stopAll();};
    }
    el.addEventListener("click",toggle);

    /* 选择：选中即全锁定 */
    el.addEventListener("dblclick",choose);
    /* 单击播放/停止，双击选定——或者加个独立确认按钮更友好 */

    box.appendChild(el);
    players.push({el,audio,timer:null});
    setTimeout(()=>el.classList.add("show"),120*i+300);
  });

  async function choose(){
    if(!current)return;
    stopAll();
    players.forEach(p=>{
      p.el.classList.add(p.el===current?"chosen":"locked");
      p.el.querySelector(".a-state").textContent=
        p.el===current?"✓ SELECTED":"MUTED";
    });
    answers[cur]={type:"audio",v:$("aopts").querySelector(".chosen .a-no").textContent};
    await sleep(700);next();
  }
  /* 建议：另设一个「确认此段 ▶」按钮调用 choose()，
     放在 nav-row 里，比双击好发现。双击保留作为快捷方式 */
}

/* ============ 无音频文件时的合成音兜底 ============ */
function synthTone(freq){
  const ctx=new (window.AudioContext||window.webkitAudioContext)();
  const o=ctx.createOscillator(),g=ctx.createGain();
  o.type="sine";o.frequency.value=freq;
  g.gain.value=.08;o.connect(g).connect(ctx.destination);
  /* 伪装成 Audio 元素的最小接口 */
  return {play(){o.start(ctx.currentTime);setTimeout(()=>{},1e9)},
          pause(){try{o.stop()}catch(e){}},
          get currentTime(){return ctx.currentTime},
          set currentTime(v){},
          set onended(fn){o.onended=fn}};
}
