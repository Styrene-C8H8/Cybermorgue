/* ===== 音频选择题 ===== */
.aopts{display:flex;flex-direction:column;gap:14px;margin-top:8px}
.aopt{
  display:flex;align-items:center;gap:18px;
  background:var(--amf);border:1px solid var(--line);
  padding:12px 20px;cursor:pointer;text-align:left;width:100%;
  color:var(--txt);font-family:'VT323','Noto Sans SC',monospace;font-size:16px;
  transition:border-color .2s,background .2s,opacity .4s;
  opacity:0;transform:translateY(10px)}
.aopt.show{opacity:1;transform:none}
.aopt:hover:not(.locked){border-color:var(--amd);background:rgba(232,176,75,.1)}
/* 正在播放 */
.aopt.playing{border-color:var(--am);box-shadow:0 0 22px rgba(232,176,75,.25),inset 0 0 18px rgba(232,176,75,.06)}
/* 已选定 */
.aopt.chosen{border-color:var(--gr);background:rgba(127,191,127,.05)}
.aopt.chosen .a-play{color:var(--gr)}
/* 被锁定的落选者 */
.aopt.locked:not(.playing):not(.chosen){opacity:.28}

/* 播放按钮：方块/三角切换 */
.a-play{flex-shrink:0;width:40px;height:40px;border:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;
  color:var(--am);font-size:17px;background:none;transition:all .2s;border-radius:50%}
.aopt.playing .a-play{animation:pBreath 1.2s ease-in-out infinite}
@keyframes pBreath{50%{box-shadow:0 0 14px rgba(232,176,75,.6)}}

/* 频谱柱：静止时是矮柱，播放时由 JS 循环取值跳动 */
.wave{flex:1;display:flex;align-items:flex-end;gap:3px;height:30px;
  min-width:90px;max-width:180px}
.wave i{flex:1;height:15%;background:var(--amd);opacity:.5;transition:height .12s}
.aopt.playing .wave i{background:var(--am);opacity:.95}
.aopt.chosen .wave i{background:var(--gr);height:20%!important;transition:height .6s}

.a-meta{display:flex;flex-direction:column;align-items:flex-end;line-height:1.4;min-width:86px}
.a-no{color:var(--ph-dim,#8a6a2f);font-size:13px;letter-spacing:.25em}
.a-dur{font-size:13.5px;color:var(--txt);opacity:.65}
.a-state{font-size:11.5px;letter-spacing:.3em;color:var(--am);height:1.2em}
