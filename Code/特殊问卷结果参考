**④ `announce()` 支持双态**（把原函数整个替换）

```js
function announce(z,isSpecial){
  $("gauge").style.display="none";
  $("stage").classList.remove("judging");

  $("vEn").textContent=z.en;
  $("vName").textContent=z.name;
  $("vTag").textContent=z.tag;
  $("vNo").textContent=z.no;
  $("vPop").textContent=z.pop;
  $("vDesc").innerHTML=z.desc;

  if(isSpecial){
    /* 结果卡整体换成红警风格 */
    const card=document.querySelector(".z-card");
    card.style.borderStyle="dashed";
    card.style.borderColor="rgba(200,90,74,.5)";
    card.querySelector(".zc-h b").style.color="var(--red)";
    $(".stamp").textContent="PENDING";
    $(".stamp").style.borderColor="var(--red)";
    document.querySelector(".z-name").style.textShadow=
      "0 0 34px rgba(200,90,74,.45)";
  }

  /* 官方宣判（两种口吻）*/
  const decree=$("decree");
  const txt=isSpecial
    ?"检测完成。未能将您匹配至任何已知分区。档案已封存，等待工作人员分配。"
    :"检测完成。您将被分配至【"+z.name+"】。档案已归档。";
  let i=0;
  (function type(){
    i++;
    decree.innerHTML=esc(txt.slice(0,i))
      .replace(/【(.*)】?$/,(m,g)=>m.endsWith("】")?"【<b>"+esc(g)+"</b>】":m+"▌");
    if(i<txt.length)setTimeout(type,55);
  })();

  $("verdict").classList.add("show");
}
```

这个特殊结局的差异化设计：

| | 普通结局 | 待分配结局 |
|---|---|---|
| 日志收尾 | `权重收敛完毕——唯一分区确定` | **连续四条失败**，节奏刻意放慢（420ms/条），像机器在挣扎 |
| 爆闪方式 | 白光爆闪 + 抖动 | **长红脉冲 + 更长的黑暗**（0.65s），不安感取代爽快感 |
| 印章 | `RECORD SEALED` 绿转琥珀正常流程 | 印章文字换 **`PENDING`** |
| 结果卡 | 左竖线琥珀面板 | 整体改**红色虚线边框**、编号 `ZONE-??`、大字带红晕 |
| 宣判句 | “您将被分配至【X】” | “**未能将您匹配至任何已知分区**……等待工作人员分配” |

介绍卡文案我也顺手埋了两个钩子：「低优先级 · 有趣」是文书科的黑色幽默，「请勿擅自选择归属地」暗示以前有人试过且后果不明——这个待分配身份之后还能和你员工终端联动（比如登录后终端里多一行 `你的分区申请仍在人工队列中（第 ██ 位）`，每次访问数字还会慢慢变动）。

正式接入时记得删掉那行演示用的 `Math.random()<0.28`，改成你打分函数的真实条件，比如「最高分与次高分差值 ≤ 1」或「总分全为零」才触发特殊分支。