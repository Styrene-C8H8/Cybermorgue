      ["> 警告：置信度不足 (31% < 60%)","lwarn"],
      ["> 尝试强制收敛 …… 失败","ler"],
      ["> 再次尝试强制收敛 …… 失败","ler"],
      ["> 特征组合超出已知分区定义域","lwarn"],
      ["> 移交人工队列 …… 已受理","lam"],
    ];
    for(const [t,c] of extra){
