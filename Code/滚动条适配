/* ============ 全局滚动条 · 复古终端风 ============ */

/* ---- Chrome / Edge / Safari ---- */
::-webkit-scrollbar{
  width:12px;height:12px;               /* 纵向/横向 */
  background:#0a0805;
}
/* 轨道：细网格纹理，呼应地图底纹 */
::-webkit-scrollbar-track{
  background:
    repeating-linear-gradient(to bottom,
      transparent 0 6px,
      rgba(232,176,75,.06) 6px 7px);
  border-left:1px solid rgba(232,176,75,.15);
}
/* 滑块：琥珀实心 + 四角切角感（用渐变模拟） */
::-webkit-scrollbar-thumb{
  background:
    linear-gradient(90deg,
      #e8b04b 0,#e8b04b calc(100% - 4px),transparent calc(100% - 4px)),
    linear-gradient(-90deg,
      #e8b04b 0,#e8b04b calc(100% - 4px),transparent calc(100% - 4px));
  background-color:#3d2f14;
  border:1px solid #8a6a2f;
}
::-webkit-scrollbar-thumb:hover{
  background-color:#8a6a2f;
  box-shadow:0 0 8px rgba(232,176,75,.5);
}
::-webkit-scrollbar-thumb:active{
  background-color:#c85a4a;             /* 按住拖动时变红——小彩蛋 */
  box-shadow:0 0 10px rgba(200,90,74,.6);
}
::-webkit-scrollbar-corner{background:#0a0805}

/* ---- Firefox（简配版）---- */
*{
  scrollbar-width:thin;
  scrollbar-color:#8a6a2f #0a0805;
}
/*迷你滚动条*/
.thin-scroll::-webkit-scrollbar{width:6px;height:6px}
.thin-scroll::-webkit-scrollbar-track{background:transparent;border:none}
.thin-scroll::-webkit-scrollbar-thumb{background:#8a6a2f;border:none}
.thin-scroll::-webkit-scrollbar-thumb:hover{box-shadow:0 0 6px rgba(232,176,75,.6)}
